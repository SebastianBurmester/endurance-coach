# Copy to coach.env in the checkout (not committed) and adjust per athlete.
# Name shown in claude.ai / the Claude app, and the prefix of its session names.
COACH_NAME="Cycling Coach"
COACH_PREFIX=cycling-coach
# Dashboard port (each athlete on the Pi needs their own).
COACH_PORT=8090
# Only for an athlete with their own Claude account: a separate Claude login for this checkout.
#CLAUDE_CONFIG_DIR=/home/pi/.claude-athlete2
# Unattended runs after each sync (each one uses this athlete's Claude plan): the morning check-in once the night's
# sleep is synced, and a review of every new session. Leave out to switch off.
#COACH_AUTO=checkin,review
# Model for the dashboard chat (default: the Claude Code default of this login).
#COACH_CHAT_MODEL=sonnet
